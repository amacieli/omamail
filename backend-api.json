      "name": "IMAP account search refuses an expired work continuation",
      "method": "imap.list",
      "params": {
        "query": "search:ALL",
        "continuation": "expired-snapshot",
        "settings": {
          "username": "synthetic",
          "imapHost": "imap.example.invalid",
          "imapPort": 993
        },
        "credential": "synthetic:secret"
      },
      "errorCode": -32000,
      "equals": {
        "message": "imap_search_expired"
      }
    },
